---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';

const REPO_URL = 'https://github.com/astralapp/astral';
const SPONSOR_URL = 'https://github.com/sponsors/syropian';
---

<section
  id="open-source"
  class="os-band relative scroll-mt-24 overflow-hidden border-y border-line/40"
>
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:items-center"
  >
    <div>
      <h2 class="text-ink text-3xl font-bold sm:text-4xl">Yours to keep, yours to run</h2>
      <p class="text-body mt-4 text-lg">
        Astral is free and AGPL-3.0-licensed. Use the hosted app, or clone the repo and run your own
        instance on Docker, backed by SQLite or MySQL. No tiers, no lock-in, no selling your data.
        Export your account data from one instance and import it into another.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={REPO_URL} external variant="primary" size="lg">
          <Icon name="lucide:github" class="size-4" aria-hidden="true" />
          Star on GitHub
        </Button>
        <Button href={SPONSOR_URL} external variant="secondary" size="lg">
          <Icon name="lucide:heart" class="size-4" aria-hidden="true" />
          Sponsor Astral
        </Button>
      </div>
    </div>

    <div class="border-line/80 bg-void/60 overflow-hidden rounded-xl border">
      <div class="border-line/60 flex items-center gap-2 border-b px-4 py-3">
        <span class="bg-line size-3 rounded-full"></span>
        <span class="bg-line size-3 rounded-full"></span>
        <span class="bg-line size-3 rounded-full"></span>
        <span class="text-muted ml-2 text-xs">self-host in a minute</span>
      </div>
      <pre
        class="overflow-x-auto px-5 py-5 text-sm leading-relaxed"><code><span class="text-muted"># clone, configure, and bring it up</span>
<span class="text-ink">git</span> clone https://github.com/astralapp/astral
<span class="text-ink">cd</span> astral
<span class="text-ink">make</span>&nbsp;<span class="text-brand-400">setup</span></code></pre>
    </div>
  </div>
</section>

<style>
  /* A soft top-lit band so self-host reads as its own surface between the
     extension (canvas) and testimonials (rail) sections. */
  .os-band {
    background: radial-gradient(100% 120% at 50% 0%, var(--color-rail), var(--color-canvas) 70%);
  }
</style>
