---
interface Props {
  class?: string;
  density?: number;
}

const { class: className, density = 130 } = Astro.props;

/** Deterministic PRNG so the field is stable across builds (no flicker on redeploy). */
function mulberry32(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), seed | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260614);
const stars = Array.from({ length: density }, () => {
  const green = rand() < 0.05;
  return {
    x: +(rand() * 100).toFixed(2),
    y: +(rand() * 100).toFixed(2),
    r: green ? +(rand() * 0.8 + 1).toFixed(2) : +(rand() * 0.8 + 0.4).toFixed(2),
    o: +(rand() * 0.5 + 0.2).toFixed(2),
    green,
    twinkle: rand() < 0.14,
    delay: +(rand() * 6).toFixed(2),
  };
});
---

<svg class:list={['starfield', className]} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  {
    stars.map((s) => (
      <circle
        cx={`${s.x}%`}
        cy={`${s.y}%`}
        r={s.r}
        fill={s.green ? 'var(--color-brand-400)' : 'var(--color-ink)'}
        opacity={s.o}
        class:list={[s.twinkle && 'twinkle']}
        style={s.twinkle ? `animation-delay:${s.delay}s` : undefined}
      />
    ))
  }
</svg>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .twinkle {
    animation: glow 6s ease-in-out infinite;
  }
</style>
