---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Get started', href: 'https://app.astralapp.com' },
      { label: 'Sign in', href: 'https://app.astralapp.com/auth' },
      { label: 'Features', href: '#features' },
      { label: 'FAQ', href: '#faq' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: 'https://github.com/astralapp/astral' },
      { label: 'Self-host', href: '#open-source' },
      { label: 'Sponsor', href: 'https://github.com/sponsors/syropian' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
    ],
  },
] as const;

const socials = [
  { label: 'Astral on GitHub', icon: 'lucide:github', href: 'https://github.com/astralapp/astral' },
  { label: 'Astral on X', icon: 'lucide:twitter', href: 'https://twitter.com/astralapp' },
  { label: 'Email Astral', icon: 'lucide:mail', href: 'mailto:hello@astralapp.com' },
] as const;
---

<footer class="border-t border-line/40 bg-rail">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <Logo class="h-6" />
        <p class="mt-4 text-sm text-muted">The calm way to organize your GitHub stars.</p>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h2 class="text-xs font-semibold tracking-wide text-ink uppercase">{col.title}</h2>
              <ul class="mt-4 space-y-2.5 text-sm">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-muted transition-colors hover:text-brand-400">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-line/40 pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} Astral, a project by{' '}
        <a
          href="https://syropia.net"
          target="_blank"
          rel="noopener noreferrer"
          class="text-body transition-colors hover:text-brand-400">Syropia</a
        >.
      </p>
      <div class="flex items-center gap-1">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-ink"
            >
              <Icon name={s.icon} class="size-5" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
